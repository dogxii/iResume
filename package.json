{
  "name": "iresume",
  "private": true,
  "version": "3.0.0-alpha.1",
  "type": "module",
  "description": "所见即所得的本地优先简历工具：直接在纸面上写，主题可自由定制，导出即所见。",
  "keywords": [
    "resume",
    "cv",
    "resume-builder",
    "wysiwyg",
    "local-first",
    "react",
    "typescript"
  ],
  "author": "Dogxi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogxii/iresume.git"
  },
  "bugs": {
    "url": "https://github.com/dogxii/iresume/issues"
  },
  "homepage": "https://github.com/dogxii/iresume#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "e2e": "playwright test --project=functional",
    "e2e:visual": "playwright test --project=visual",
    "e2e:browsers": "playwright test --project=functional --project=firefox --project=webkit"
  },
  "dependencies": {
    "lucide-react": "^0.556.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "fake-indexeddb": "^6.2.5",
    "jszip": "^3.10.2",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
