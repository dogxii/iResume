{
	"name": "iresume-workspace",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"description": "一个基于 React + TypeScript + Tailwind CSS 的在线简历生成器",
	"keywords": [
		"resume",
		"cv",
		"resume-builder",
		"react",
		"typescript",
		"tailwind",
		"pdf-generator"
	],
	"author": "Dogxi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/dogxii/iresume.git"
	},
	"bugs": {
		"url": "https://github.com/dogxii/iresume/issues"
	},
	"homepage": "https://github.com/dogxii/iresume#readme",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && npm run build:app",
		"build:app": "vite build",
		"build:cli": "cd packages/cli && npm run build",
		"lint": "eslint .",
		"test": "vitest run",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
